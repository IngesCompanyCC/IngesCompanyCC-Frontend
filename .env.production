# Environment: Production
# Description: Environment variables for the production environment
# VITE_PLATFORM_API_URL points to the published fake API until the DoofPlus RESTful API is deployed
VITE_PLATFORM_API_URL="https://ingescompany-frontend.onrender.com/api/v1"
# Endpoint paths of the IAM bounded context
VITE_USERS_ENDPOINT_PATH="/users"
# VITE_LANDING_PAGE_URL is the published Landing Page, used for the legal links in the footer.
VITE_LANDING_PAGE_URL="https://ingescompanycc.github.io/IngesCompanyCC-LanginPage/"
