# Environment: Development
# Description: Environment variables for the development environment
# VITE_PLATFORM_API_URL points to the fake API (npm run server) on port 3000
VITE_PLATFORM_API_URL="http://localhost:3000/api/v1"
# Endpoint paths of the IAM bounded context
VITE_USERS_ENDPOINT_PATH="/users"
# Endpoint paths of the Manufacturing bounded context
VITE_PRODUCTS_ENDPOINT_PATH="/products"
VITE_MASTER_FORMULAS_ENDPOINT_PATH="/master-formulas"
VITE_FORMULA_ITEMS_ENDPOINT_PATH="/formula-items"
VITE_PRODUCTION_ORDERS_ENDPOINT_PATH="/production-orders"
VITE_OPERATIONS_ENDPOINT_PATH="/operations"
VITE_BATCHES_ENDPOINT_PATH="/batches"
VITE_BATCH_EVENTS_ENDPOINT_PATH="/batch-events"
VITE_MATERIAL_LOTS_ENDPOINT_PATH="/material-lots"
# Endpoint paths of the Subscriptions & Payments bounded context
VITE_PLANS_ENDPOINT_PATH="/plans"
VITE_SUBSCRIPTIONS_ENDPOINT_PATH="/subscriptions"
VITE_INVOICES_ENDPOINT_PATH="/invoices"
# Endpoint paths of the Organization Management bounded context
VITE_ORGANIZATIONS_ENDPOINT_PATH="/organizations"
VITE_FACILITIES_ENDPOINT_PATH="/facilities"
VITE_USER_PROFILES_ENDPOINT_PATH="/user-profiles"
VITE_ADMINISTRATIVE_ACTIVITIES_ENDPOINT_PATH="/administrative-activities"
# Endpoint paths of the IoT Monitoring bounded context
VITE_EQUIPMENT_ENDPOINT_PATH="/equipment"
VITE_SENSORS_ENDPOINT_PATH="/sensors"
VITE_READINGS_ENDPOINT_PATH="/readings"
VITE_ALERTS_ENDPOINT_PATH="/alerts"
